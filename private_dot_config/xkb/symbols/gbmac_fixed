// User XKB layout for Omarchy/Hyprland.
// Based on English (UK, Macintosh), with either Alt key producing
// Option-style symbols on selected number-row keys, and the ANSI top-left
// key restored to backtick/tilde instead of UK Mac section/plusminus.
partial alphanumeric_keys
xkb_symbols "basic" {
    include "gb(mac)"

    name[Group1] = "English (UK, Macintosh fixed)";

    key <AE02> {
        type[Group1] = "FOUR_LEVEL_OPTION",
        [ 2, at, EuroSign, EuroSign ]
    };
    key <AE03> {
        type[Group1] = "FOUR_LEVEL_OPTION",
        [ 3, sterling, numbersign, numbersign ]
    };
    key <AE04> {
        type[Group1] = "FOUR_LEVEL_OPTION",
        [ 4, dollar, numbersign, numbersign ]
    };

    // ANSI top-left key: ` and ~
    key <TLDE> {
        [ grave, asciitilde, grave, asciitilde ]
    };

    // ISO extra key: also keep as ` and ~ for external boards that report this key.
    key <LSGT> {
        [ grave, asciitilde, grave, asciitilde ]
    };
};
